{
    "name": "atelier",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "packageManager": "pnpm@10.34.6",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^24.15.0",
            "onFail": "download"
        }
    },
    "scripts": {
        "dev": "vite",
        "typecheck": "tsc -b",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "format": "prettier --write ./src",
        "preview": "vite preview",
        "test": "vitest run"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.12.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "fake-indexeddb": "~6.2.5",
        "globals": "^17.13.0",
        "jsdom": "^30.1.2",
        "prettier": "^3.9.10",
        "prettier-plugin-css-order": "^2.2.0",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.4",
        "vitest": "^5.0.4"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource/bebas-neue": "^5.3.0",
        "@fontsource/pt-serif": "^5.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@zumer/snapdom": "~3.3.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "js-yaml": "^5.4.3",
        "lucide-react": "^1.55.0",
        "radix-ui": "^1.8.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-grid-layout": "~2.3.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.6",
        "zustand": "^5.0.15"
    }
